[Unit]
Description=Check RenCrow deployed binary drift and notify on state change

[Service]
Type=oneshot
EnvironmentFile=%h/.rencrow/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=RENCROW_CONFIG=%h/.rencrow/config/core.yaml
ExecStart=%h/.local/share/rencrow/binary-drift-monitor/check_deployed_binaries_notify.py
